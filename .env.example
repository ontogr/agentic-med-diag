# AmDiag client state (Registry JSON + durable job/cache directory)
# AM_DIAG_REGISTRY_PATH defaults to <AM_DIAG_STATE_DIR>/registry.json
AM_DIAG_STATE_DIR=.am_diag
AM_DIAG_REGISTRY_PATH=.am_diag/registry.json

# Per-graph connection secrets are referenced by env-var NAME in the Registry,
# so each graph can point at its own backend. Example for a graph "med":
MED_NEO4J_USER=neo4j
MED_NEO4J_PASSWORD=your-neo4j-password
MED_QDRANT_URL=http://localhost:6333
MED_QDRANT_KEY=

# LLM Configuration (used by am_diag.infrastructure.llm)
LLM_MODEL=gpt-4o-mini
LLM_ENDPOINT=https://api.openai.com/v1
LLM_API_KEY=your-openai-api-key

# OpenAI-compatible LLM backend (used by BAML OpenAIGeneric / OpenAIGenericRobust)
OPENAI_GENERIC_BASE_URL=http://localhost:11434/v1
OPENAI_GENERIC_API_KEY=your-api-key-here
OPENAI_GENERIC_MODEL=gemma4:31b

# BAML LLM Configuration (used for structured output / graph extraction)
BAML_LLM_MODEL=gpt-4o-mini
BAML_LLM_ENDPOINT=https://api.openai.com/v1
BAML_LLM_API_KEY=your-openai-api-key

# Embedding Configuration (fastembed - local, no API key required)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
HUGGINGFACE_TOKENIZER=gpt-4o

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Graph Database (FalkorDB, optional)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=am_diag
FALKORDB_SSL=false
FALKORDB_QUERY_TIMEOUT_MS=30000
FALKORDB_MAX_CONNECTIONS=16

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Agentic RAG settings
AGENT_MAX_ITERATIONS=5
AGENT_SEARCH_TOP_K=20
AGENT_RERANKER_THRESHOLD=0.4

# Relational Database (SQLite - auto-created, path relative to project root)
DB_PATH=.am_diag_system/databases
DB_NAME=am_diag_db

# Optional: override default storage directories
# AM_DIAG_LOGS_DIR=~/.am_diag/logs

# OpenAI API Key (used directly by BAML evaluation judges in baml_src/clients.baml)
OPENAI_API_KEY=your-openai-api-key
